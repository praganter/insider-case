#!/bin/sh
# Blocks commits of session exports that still contain local info. Enable with `make hooks`.
files=$(git diff --cached --name-only --diff-filter=AM -- ai-sessions)
[ -z "$files" ] && exit 0
py=$(command -v python3 || command -v python) || { echo "python not found" >&2; exit 1; }
exec "$py" .claude/skills/ship-session/scripts/session.py check $files
