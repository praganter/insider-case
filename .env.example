# Empty ANTHROPIC_API_KEY runs the app in mock LLM mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
POSTGRES_PASSWORD=app
POSTGRES_USER=app
POSTGRES_DB=app
# Share (0..1) of mock provider calls answered with an error or a 429, to watch retries work.
PROVIDER_ERROR_RATE=0.05
PROVIDER_TOO_MANY_RATE=0.05
# Host ports for connecting from your own tools (localhost only).
POSTGRES_PORT=5433
REDIS_PORT=6380
